package application

import "context"

// User 是 audit 模块执行用例所需的最小用户数据。
type User struct {
	ID   int64
	Name string
}

// UserReader 由消费方定义，表示 audit 模块需要的用户查询能力。
type UserReader interface {
	GetUser(ctx context.Context, id int64) (*User, error)
}

// Entry 是 audit 模块生成的审计视图。
type Entry struct {
	UserID   int64
	UserName string
	Action   string
}

type Service struct {
	users UserReader
}

func NewService(users UserReader) *Service {
	return &Service{users: users}
}

// GetUserAccess 演示 audit 模块通过公开契约读取 user 模块的数据。
func (s *Service) GetUserAccess(ctx context.Context, userID int64) (*Entry, error) {
	user, err := s.users.GetUser(ctx, userID)
	if err != nil {
		return nil, err
	}

	return &Entry{
		UserID:   user.ID,
		UserName: user.Name,
		Action:   "read_user",
	}, nil
}
