package api

import (
	"{{ .Title }}/internal/module/user/api/res"
	"{{ .Title }}/internal/module/user/core"
)

func toResponse(u *core.User) *res.UserResponse {
	return &res.UserResponse{
		ID:     u.ID,
		Name:   u.Name,
		Email:  u.Email,
		Status: int(u.Status),
	}
}

func toResponseList(users []*core.User) []*res.UserResponse {
	result := make([]*res.UserResponse, len(users))
	for i, user := range users {
		result[i] = toResponse(user)
	}
	return result
}
