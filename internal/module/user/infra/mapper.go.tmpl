package infra

import (
	"{{ .Title }}/internal/module/user/core"
	"{{ .Title }}/internal/module/user/infra/model"
)

// toModel 把核心数据结构转换成数据库模型。
func toModel(u *core.User) *model.UserModel {
	return &model.UserModel{
		ID:        u.ID,
		Name:      u.Name,
		Email:     u.Email,
		Status:    int(u.Status),
		CreatedAt: u.CreatedAt,
		UpdatedAt: u.UpdatedAt,
	}
}

// toCore 把数据库模型转换成核心数据结构。
func toCore(m *model.UserModel) *core.User {
	return &core.User{
		ID:        m.ID,
		Name:      m.Name,
		Email:     m.Email,
		Status:    core.Status(m.Status),
		CreatedAt: m.CreatedAt,
		UpdatedAt: m.UpdatedAt,
	}
}

func toCoreList(models []model.UserModel) []*core.User {
	users := make([]*core.User, len(models))
	for i, item := range models {
		users[i] = toCore(&item)
	}
	return users
}
