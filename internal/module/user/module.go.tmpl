package user

import (
	"github.com/gin-gonic/gin"
	"gorm.io/gorm"

	"{{ .Title }}/internal/config"
	"{{ .Title }}/internal/module/user/api"
	userRes "{{ .Title }}/internal/module/user/api/res"
	"{{ .Title }}/internal/module/user/application"
	"{{ .Title }}/internal/module/user/contract"
	"{{ .Title }}/internal/module/user/infra"
	"{{ .Title }}/internal/pkg/migration"
)

// Dependencies 表示 user 模块对外部基础设施的依赖。
type Dependencies struct {
	DB     *gorm.DB
	Config *config.Config
}

// Module 保存 user 模块装配后的内部组件。
type Module struct {
	handler *api.Handler
	reader  contract.UserReader
}

func New(dep Dependencies) *Module {
	repo := infra.NewUserRepository(dep.DB)
	service := application.NewService(repo, dep.Config)
	return &Module{
		handler: api.NewHandler(service),
		reader:  newUserReader(service),
	}
}

// RegisterHTTP 注册 user 模块的 HTTP 入口。
func (m *Module) RegisterHTTP(rg *gin.RouterGroup) {
	userRes.RegisterCode()
	api.RegisterRoutes(rg, m.handler)
}

// UserReader 返回 user 模块对其他模块公开的只读契约。
func (m *Module) UserReader() contract.UserReader {
	return m.reader
}

// RegisterMigrations 注册 user 模块自己的数据库迁移。
func RegisterMigrations(registry *migration.MigrationRegistry) {
	infra.RegisterMigrations(registry)
}
